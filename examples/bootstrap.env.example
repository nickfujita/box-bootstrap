# box-bootstrap runtime environment (EXAMPLE — contains NO real secrets)
#
# Copy this file somewhere private, fill in the real values, then source it
# right before running install.sh:
#
#     cp examples/bootstrap.env.example ~/bootstrap.env
#     chmod 600 ~/bootstrap.env
#     $EDITOR ~/bootstrap.env
#     set -a; . ~/bootstrap.env; set +a
#     ./install.sh
#
# install.sh reads everything from the environment — never commit filled-in
# copies of this file.

# ── Personal tailnet (component: tailscale) ──────────────────────────────────
# Tagged auth key minted in the PERSONAL tailnet admin console. Must be a
# reusable/ephemeral key authorized for tag:cloud-dev (see README).
export TS_AUTHKEY="tskey-auth-REPLACE_ME"
# Node name to register in the personal tailnet (usually the box's letter/name).
# Also used to build the go-grip URL in ~/.codex/AGENTS.md.
export BOX_NAME="cloud-dev-x"

# ── Matrix bridge (component: matrix) ────────────────────────────────────────
# Matrix homeserver base URL.
export CCMATRIX_HOMESERVER="https://matrix.example.org"
# The bot/user this box logs in as.
export CCMATRIX_USER_ID="@ccmatrix-x:example.org"
# Access token for CCMATRIX_USER_ID (secret).
export CCMATRIX_ACCESS_TOKEN="syt_REPLACE_ME"
# Your own Matrix user id — the admin allowed to drive the bridge.
export CCMATRIX_ADMIN_USER_ID="@you:example.org"
# Outbound proxy the bridge uses to reach the personal tailnet. Defaults to the
# personal tailscaled's HTTP proxy; leave unset to accept the default.
export CCMATRIX_PROXY_URL="http://127.0.0.1:1055"
# Single-letter suffix identifying this box (e.g. a, b, c). Exported into
# ~/.profile by install.sh. REQUIRED.
export CCMATRIX_VM_LETTER="x"

# ── Claude Code plugins marketplace (component: matrix) ───────────────────────
# The public plugins repo that ships the Matrix bridge plugin.
export PLUGINS_REPO_URL="nickfujita/matrix-bridge-plugin"

# ── Push notifications (component: notifications) ────────────────────────────
# Endpoint the notify-*.sh hooks POST to. REQUIRED for --notifications unless
# ~/.config/moshi/webhook.env already exists.
export MOSHI_WEBHOOK_URL="https://api.getmoshi.app/api/webhook"
# Per-account webhook token sent in the request body (SECRET). Leave empty for
# an endpoint that authenticates by URL alone.
#
# install.sh writes both values to ~/.config/moshi/webhook.env at mode 0600, and
# the scripts source that file at RUNTIME — so rotating the token is an edit of
# that file, never a reinstall.
export MOSHI_WEBHOOK_TOKEN="REPLACE_ME"

# ── Global agent instructions (component: global-instructions) ───────────────
# MagicDNS domain of your personal tailnet, e.g. tailXXXXXX.ts.net. Combined
# with BOX_NAME to build the go-grip browsable base URL that the File Links
# section of ~/.codex/AGENTS.md tells agents to use.
export PERSONAL_TAILNET="tailXXXXXX.ts.net"
# Optional: set this to skip the BOX_NAME + PERSONAL_TAILNET assembly entirely.
# export GOGRIP_BASE_URL="http://cloud-dev-x.tailXXXXXX.ts.net:6419"

# ── Shell block (component: shell) ───────────────────────────────────────────
# Optional. Needed for wrangler / Spellguard dev-stack deploys. When set,
# install.sh writes it to ~/.config/box-bootstrap/shell.env at mode 0600 (NOT
# into the world-readable ~/.bashrc), and the shell block sources that file.
# Rotate by editing ~/.config/box-bootstrap/shell.env.
# export CLOUDFLARE_API_TOKEN="REPLACE_ME"
#
# Optional. Node heap ceiling in MB for the long-running agent CLIs. Defaults
# to 12288 (sized for a 16 GB box); lower it on a smaller instance.
# export NODE_MAX_OLD_SPACE_MB="8192"

# ── dark-factory (component: dark-factory) ───────────────────────────────────
# Optional. Override to install the skills repo from a fork.
# export DARK_FACTORY_REPO_URL="https://github.com/nickfujita/dark-factory.git"

# ── Claude plugins (component: agent-config) ─────────────────────────────────
# Optional. Override to install the official plugins from a mirror.
# export CLAUDE_MARKETPLACE="anthropics/claude-plugins-official"
